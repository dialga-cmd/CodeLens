# Copy to .env.local and fill in. Only the first value is needed to run the
# demo; the Firebase block is optional and only enables Google sign-in.
#
#   cp .env.example .env.local
#
# Note: this project uses `output: "export"`, so these values are inlined into
# the JavaScript bundle at build time. Changing one means rebuilding, not
# restarting. Nothing secret goes here: every NEXT_PUBLIC_ value is public.

# --- Backend -----------------------------------------------------------------
# Where the FastAPI service is. A trailing slash is fine; requests are resolved
# against it, so a value like https://api.example.com also works.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Only set this if /health fails in the browser for a reason other
# than the backend being down - for example when a proxy blocks cross-origin
# requests to the API but the health endpoint is reachable directly. Leave it
# unset and the status panel reads /health from NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_RENDER_BACKEND_HEALTH_URL=https://your-backend.example.com/health

# --- Optional: Google sign-in -----------------------------------------------
# With these unset the app runs in guest mode, which is how the judge-facing
# deployment runs. Sign-in adds per-account history; it is not required for
# any feature. All six must be present or the app falls back to guest mode.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
