# --- Nebius Token Factory (models) -----------------------------------------
# Create a key at https://tokenfactory.nebius.com/ and paste it here. Never commit it.
NEBIUS_API_KEY=
# Optional: override the host (use a regional host such as
# https://api.tokenfactory.eu-west1.nebius.com/v1/ if your account is region-scoped).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Heavy model for reasoning-heavy work, fast model for high-volume work.
NEBIUS_MODEL_HEAVY=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
# Optional tuning: NEBIUS_REQUEST_TIMEOUT, NEBIUS_MAX_RETRIES, NEBIUS_MAX_CONCURRENCY

# --- Tavily (grounds dependency and security verdicts) ---------------------
# Get a key at https://app.tavily.com/home. Analysis degrades gracefully without it.
TAVILY_API_KEY=
# Search budgets per analysis run. Each search costs a Tavily credit, so these
# are deliberately small; anything beyond them is reported as "not checked".
# CODELENS_TAVILY_ADVISORY_QUERIES=8
# CODELENS_TAVILY_VERSION_QUERIES=5
# CODELENS_TAVILY_FINDING_QUERIES=3
# CODELENS_RESEARCH_CONCURRENCY=4
# TAVILY_TIMEOUT=25

# --- Analysis limits --------------------------------------------------------
# CODELENS_MAX_FILES=250
# CODELENS_MAX_FILE_BYTES=200000
# CODELENS_GIT_HISTORY_DEPTH=40
# CODELENS_GIT_CHURN_LINES=false
# CODELENS_ENABLE_AI_ANALYSIS=true

# --- Optional: Google sign-in ----------------------------------------------
# Leave unset to run in guest mode. Set the service account JSON or its path to
# require a Firebase ID token.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- HTTP ------------------------------------------------------------------
CODELENS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_VERCEL_ORIGINS=true
