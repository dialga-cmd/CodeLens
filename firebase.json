{
  "hosting": {
    "public": "client/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/results",
        "destination": "/results.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
